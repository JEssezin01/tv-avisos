# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NAO vai para o git (ver .gitignore).

# Porta interna do app. O Nginx aponta para ela.
# Nao pode colidir com 3000 (app financeiro) nem 20080 (servidor MTA) na VPS.
PORT=4173

# Segredo para assinar o cookie de sessao. Gere um valor aleatorio longo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Hash bcrypt da senha do painel. Gere com:
#   npm run hash -- "suaSenhaAqui"
# Cole aqui a linha que o comando imprimir.
ADMIN_PASSWORD_HASH=

# true em producao (atras de HTTPS no Nginx). false para testar local em http://localhost.
COOKIE_SECURE=false

# Quantos proxies existem na frente do app. Nginx = 1. Local sem proxy = 0.
TRUST_PROXY=0

# Midia: tamanho maximo por arquivo (MB) e espaco total no servidor (MB).
MAX_UPLOAD_MB=150
STORAGE_LIMIT_MB=3072
